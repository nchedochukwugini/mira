# Demo fixtures are opt-in for local development only. Production requires Panta.
# Panta API keys are server-only: pk_test_* is PANTA TEST; pk_live_* is PANTA LIVE.
PANTA_API_BASE_URL=https://live-api.panta.market/api/v1
PANTA_API_KEY=replace_with_your_panta_api_key
# Server-only RPC endpoint used by the read-only Panta CLOB adapter. Never use NEXT_PUBLIC_ here.
SOLANA_RPC_URL=https://your-solana-rpc.example.invalid
TAVILY_API_KEY=replace_with_your_tavily_api_key
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Optional bearer token for an external scheduler calling POST /api/markets/collect-snapshots.
# Keep server-only; never use a NEXT_PUBLIC_ prefix.
SNAPSHOT_COLLECTOR_TOKEN=replace_with_a_long_random_token
# Persistent Node worker polling cadence (server-side only).
ORDERBOOK_POLL_INTERVAL_MS=10000
TRADE_HISTORY_POLL_INTERVAL_MS=45000
MARKET_WORKER_MAX_MARKETS=10
# Optional objective alert thresholds; unset values disable those alert types.
MARKET_ALERT_SPREAD_MAX=
MARKET_ALERT_DEPTH_CHANGE_PCT=
MARKET_ALERT_COOLDOWN_MS=900000
NEXT_PUBLIC_MARKET_PROVIDER=demo
# Panta Test uses devnet. Panta Live requires mainnet-beta and a mainnet RPC URL.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://your-wallet-rpc.example.invalid
